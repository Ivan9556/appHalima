<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/fondoApp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textNom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre reserva" />
        <TextView
            android:id="@+id/textApe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apellidos reserva" />
        <TextView
            android:id="@+id/textFechaEntrada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha Entrada"/>
        <TextView
            android:id="@+id/textFechaSalida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha Salida"/>
        <TextView
            android:id="@+id/numAdultos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Numero adultos"/>
        <TextView
            android:id="@+id/numNiños"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Numero Niños"/>
        <TextView
            android:id="@+id/telefono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telefono"/>
        <TextView
            android:id="@+id/correo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo electronico"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>