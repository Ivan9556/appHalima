<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/reservaFragment">

    <fragment
        android:id="@+id/reservaFragment"
        android:name="com.example.halimaapp.fragments.ReservaFragment"
        android:label="fragment_reserva"
        tools:layout="@layout/fragment_reserva" >
        <action
            android:id="@+id/action_reservaFragment_to_detail_view"
            app:destination="@id/detail_view" />
        <action
            android:id="@+id/action_reservaFragment_to_mensajesFragment"
            app:destination="@id/mensajesFragment" />
        <action
            android:id="@+id/action_reservaFragment_to_usuarioFragment"
            app:destination="@id/usuarioFragment" />
        <action
            android:id="@+id/action_reservaFragment_to_newReserva"
            app:destination="@id/newReserva" />
    </fragment>
    <fragment
        android:id="@+id/mensajesFragment"
        android:name="com.example.halimaapp.fragments.MensajesFragment"
        android:label="fragment_mensajes"
        tools:layout="@layout/fragment_mensajes" />
    <fragment
        android:id="@+id/usuarioFragment"
        android:name="com.example.halimaapp.fragments.UsuarioFragment"
        android:label="fragment_usuario"
        tools:layout="@layout/fragment_usuario" />
    <fragment
        android:id="@+id/detail_view"
        android:name="com.example.halimaapp.fragments.detailCardFragment"
        android:label="detail_view"
        tools:layout="@layout/detail_card_view" />
    <fragment
        android:id="@+id/newReserva"
        android:name="com.example.halimaapp.fragments.newReserva"
        android:label="Nueva reserva"
        tools:layout="@layout/new_reserva"/>

</navigation>